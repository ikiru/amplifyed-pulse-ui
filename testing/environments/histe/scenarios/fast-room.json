  "messages": [
    { "id": "m1", "from": "p1", "delayMs": 0, "text": "Let’s ground ourselves. What norms matter most when discussions get heated?", "threadId": null },
    { "id": "m2", "from": "p2", "delayMs": 900, "text": "Time limits help. Otherwise a few voices dominate.", "threadId": "m1" },
    { "id": "m3", "from": "p3", "delayMs": 1100, "text": "Agreed. I also think clarifying intent early prevents spirals.", "threadId": "m1" },
    { "id": "m4", "from": "p4", "delayMs": 1300, "text": "Is this about chat norms specifically or facilitation norms overall?", "threadId": "m1" },

    { "id": "m5", "from": "p5", "delayMs": 2000, "text": "I want to flag that some people process slower in chat.", "threadId": null },
    { "id": "m6", "from": "p6", "delayMs": 2100, "text": "Yes, silence doesn’t always mean disengaged.", "threadId": "m5" },
    { "id": "m7", "from": "p2", "delayMs": 2300, "text": "But long silence can stall momentum.", "threadId": "m5" },
    { "id": "m8", "from": "p5", "delayMs": 2600, "text": "True, but nudging gently matters.", "threadId": "m5" },

    { "id": "m9", "from": "p3", "delayMs": 3200, "text": "Can we define what we mean by \"heated\"?", "threadId": null },
    { "id": "m10", "from": "p1", "delayMs": 3400, "text": "Good question. I mean emotionally charged or fast-paced.", "threadId": "m9" },
    { "id": "m11", "from": "p4", "delayMs": 3500, "text": "Sometimes fast-paced is fine if it’s still respectful.", "threadId": "m9" },

    { "id": "m12", "from": "p6", "delayMs": 4200, "text": "I’m noticing overlap already 😅", "threadId": null },
    { "id": "m13", "from": "p2", "delayMs": 4300, "text": "Which is kind of meta.", "threadId": "m12" },
    { "id": "m14", "from": "p1", "delayMs": 4400, "text": "Let’s let this happen for a second.", "threadId": "m12" },

    { "id": "m15", "from": "p4", "delayMs": 5000, "text": "Back to norms: what about acknowledging before disagreeing?", "threadId": "m1" },
    { "id": "m16", "from": "p3", "delayMs": 5200, "text": "That reduces defensiveness a lot.", "threadId": "m1" },
    { "id": "m17", "from": "p2", "delayMs": 5300, "text": "Yes, but it can feel scripted if overdone.", "threadId": "m1" },

    { "id": "m18", "from": "p5", "delayMs": 6000, "text": "Does anyone use explicit turn-taking in chat?", "threadId": null },
    { "id": "m19", "from": "p6", "delayMs": 6200, "text": "Rarely. It slows things down.", "threadId": "m18" },
    { "id": "m20", "from": "p1", "delayMs": 6300, "text": "Sometimes useful in conflict moments.", "threadId": "m18" },

    { "id": "m21", "from": "p3", "delayMs": 7000, "text": "I’m a little confused which thread to follow now.", "threadId": null },
    { "id": "m22", "from": "p4", "delayMs": 7100, "text": "Same. Maybe we should consolidate.", "threadId": "m21" },
    { "id": "m23", "from": "p2", "delayMs": 7200, "text": "This is a good example of drift.", "threadId": "m21" },

    { "id": "m24", "from": "p1", "delayMs": 8000, "text": "Let’s pause and name the main threads we have.", "threadId": null },
    { "id": "m25", "from": "p5", "delayMs": 8200, "text": "Norms for pace", "threadId": "m24" },
    { "id": "m26", "from": "p6", "delayMs": 8300, "text": "Norms for disagreement", "threadId": "m24" },
    { "id": "m27", "from": "p3", "delayMs": 8400, "text": "Norms for silence", "threadId": "m24" },

    { "id": "m28", "from": "p4", "delayMs": 9000, "text": "I want to return to silence norms.", "threadId": null },
    { "id": "m29", "from": "p2", "delayMs": 9200, "text": "Same. Silence is often misread.", "threadId": "m28" },
    { "id": "m30", "from": "p5", "delayMs": 9400, "text": "Especially for neurodivergent participants.", "threadId": "m28" },

    { "id": "m31", "from": "p6", "delayMs": 10000, "text": "Is anyone else feeling a bit overloaded?", "threadId": null },
    { "id": "m32", "from": "p3", "delayMs": 10100, "text": "Yes.", "threadId": "m31" },
    { "id": "m33", "from": "p4", "delayMs": 10150, "text": "Same here.", "threadId": "m31" },

    { "id": "m34", "from": "p1", "delayMs": 11000, "text": "That’s useful feedback. Let’s slow the pace.", "threadId": null },

    { "id": "m35", "from": "p2", "delayMs": 12000, "text": "Thanks for naming that.", "threadId": "m34" },
    { "id": "m36", "from": "p5", "delayMs": 12100, "text": "Appreciated.", "threadId": "m34" },

    { "id": "m37", "from": "p3", "delayMs": 13000, "text": "Can we capture these norms explicitly?", "threadId": null },
    { "id": "m38", "from": "p6", "delayMs": 13200, "text": "Yes, otherwise we lose them.", "threadId": "m37" },

    { "id": "m39", "from": "p4", "delayMs": 14000, "text": "I’ll draft a quick summary.", "threadId": null },

    { "id": "m40", "from": "p1", "delayMs": 15000, "text": "Before that—any last disagreements?", "threadId": null },

    { "id": "m41", "from": "p2", "delayMs": 16000, "text": "I still think too many norms can constrain.", "threadId": "m40" },
    { "id": "m42", "from": "p5", "delayMs": 16200, "text": "But absence of norms can exclude.", "threadId": "m40" },

    { "id": "m43", "from": "p3", "delayMs": 17000, "text": "This feels like a productive tension.", "threadId": "m40" },

    { "id": "m44", "from": "p6", "delayMs": 18000, "text": "Agreed.", "threadId": "m40" },

    { "id": "m45", "from": "p4", "delayMs": 19000, "text": "Draft summary coming next.", "threadId": null },

    { "id": "m46", "from": "p4", "delayMs": 20000, "text": "Summary: pace awareness, acknowledge before disagreeing, normalize silence.", "threadId": "m45" },

    { "id": "m47", "from": "p1", "delayMs": 21000, "text": "Does this reflect the room?", "threadId": "m45" },

    { "id": "m48", "from": "p2", "delayMs": 22000, "text": "Mostly, yes.", "threadId": "m45" },

    { "id": "m49", "from": "p5", "delayMs": 22100, "text": "I’d add explicit check-ins.", "threadId": "m45" },

    { "id": "m50", "from": "p6", "delayMs": 22200, "text": "Seconded.", "threadId": "m45" },

    { "id": "m51", "from": "p3", "delayMs": 23000, "text": "This feels solid.", "threadId": "m45" },

    { "id": "m52", "from": "p1", "delayMs": 24000, "text": "Great. Let’s close this loop.", "threadId": null },

    { "id": "m53", "from": "p4", "delayMs": 25000, "text": "Thanks everyone.", "threadId": "m52" },

    { "id": "m54", "from": "p2", "delayMs": 25100, "text": "Appreciate the space.", "threadId": "m52" },

    { "id": "m55", "from": "p5", "delayMs": 25200, "text": "Same.", "threadId": "m52" },

    { "id": "m56", "from": "p6", "delayMs": 25300, "text": "Helpful discussion.", "threadId": "m52" },

    { "id": "m57", "from": "p3", "delayMs": 26000, "text": "Ready to move on.", "threadId": "m52" },

    { "id": "m58", "from": "p1", "delayMs": 27000, "text": "We’ll transition in a moment.", "threadId": null },

    { "id": "m59", "from": "p2", "delayMs": 28000, "text": "Before we do—can we save that summary?", "threadId": "m58" },

    { "id": "m60", "from": "p4", "delayMs": 28100, "text": "Already captured.", "threadId": "m58" },

    { "id": "m61", "from": "p5", "delayMs": 29000, "text": "Nice.", "threadId": "m58" },

    { "id": "m62", "from": "p6", "delayMs": 30000, "text": "Thanks.", "threadId": "m58" },

